{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mails-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mails-db",
      "database_id": "b55c9ae9-daad-42b5-8306-fb5ae0ba787e",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "mails-send" }],
    "consumers": [
      {
        "queue": "mails-send",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        // Keep well under the SES account send rate.
        "max_concurrency": 3,
        "dead_letter_queue": "mails-send-dlq"
      }
    ]
  },
  "triggers": {
    // Picks up scheduled campaigns every minute.
    "crons": ["* * * * *"]
  },
  "routes": [{ "pattern": "mails-api.haxzie.com", "custom_domain": true }],
  "vars": {
    // Local development overrides these in apps/api/.dev.vars.
    "APP_URL": "https://mails.haxzie.com",
    "API_URL": "https://mails-api.haxzie.com",
    "ALLOWED_EMAILS": "musthu.gm@gmail.com",
    "SYSTEM_SES_REGION": "ap-south-1",
    "SYSTEM_FROM_NAME": "Mails"
  }
}
