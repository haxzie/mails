{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mails-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mails-db",
      // Replace with the id printed by `wrangler d1 create mails-db`.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "mails-send" }],
    "consumers": [
      {
        "queue": "mails-send",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        // Keep well under the SES account send rate.
        "max_concurrency": 3,
        "dead_letter_queue": "mails-send-dlq"
      }
    ]
  },
  "triggers": {
    // Picks up scheduled campaigns every minute.
    "crons": ["* * * * *"]
  },
  "vars": {
    "APP_URL": "http://localhost:3000",
    "API_URL": "http://localhost:8787",
    "ALLOWED_EMAILS": "musthu.gm@gmail.com",
    "SYSTEM_SES_REGION": "us-east-1",
    "SYSTEM_FROM_NAME": "Mails"
  }
}
