{
  "name": "mails",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "pnpm --filter @mails/web dev",
    "dev:api": "pnpm --filter @mails/api dev",
    "build": "pnpm --filter @mails/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @mails/web lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @mails/db generate",
    "db:migrate:local": "pnpm --filter @mails/db migrate:local",
    "db:migrate:remote": "pnpm --filter @mails/db migrate:remote",
    "deploy": "pnpm --filter @mails/api deploy && pnpm --filter @mails/web deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
