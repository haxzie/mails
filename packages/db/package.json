{
  "name": "@mails/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply mails-db --local --persist-to ../../.wrangler/state --config ../../apps/api/wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply mails-db --remote --config ../../apps/api/wrangler.jsonc",
    "typecheck": "tsc -p tsconfig.json",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251011.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.0"
  }
}
